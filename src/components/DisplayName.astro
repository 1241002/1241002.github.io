---
// Home name: letters rise in one by one, CSS only (no JS, visible without it).
// Screen readers get the plain name; the per-letter spans are hidden from them.
interface Props {
  name: string;
}

const { name } = Astro.props;
const words = name.split(" ");
// Running letter index across words, so the stagger continues after the space.
const offsets = words.map((_, w) =>
  words.slice(0, w).reduce((sum, word) => sum + word.length, 0),
);
const total = name.replaceAll(" ", "").length;
---

<h1 class="text-display-fit col-span-full uppercase">
  <span class="sr-only">{name}</span>
  <span aria-hidden="true">
    {words.map((word, w) => (
      <>
        <span class="whitespace-nowrap">
          {[...word].map((char, c) => (
            <span class="letter" style={`--i: ${offsets[w] + c}`}>
              {char}
            </span>
          ))}
          {w === words.length - 1 && (
            <span class="letter text-signal" style={`--i: ${total}`}>
              .
            </span>
          )}
        </span>{" "}
      </>
    ))}
  </span>
</h1>

<style>
  .letter {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .letter {
      animation: letter-in 600ms var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 45ms);
    }
  }
  @keyframes letter-in {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
  }
</style>
