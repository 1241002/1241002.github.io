---
// GitHub Pages cannot negotiate language: `/` always sends visitors to PT.
import { localePath, defaultLocale } from "@/i18n/ui";

const target = localePath(defaultLocale);
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alexandre Costa</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>
      <a href={target}>Alexandre Costa — portfólio</a>
    </p>
  </body>
</html>
